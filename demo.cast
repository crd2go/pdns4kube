[0.001, "o", "\u001b[?2026h\u001b[1;35r\u001b[1;1H\u001b[12S\u001b[14B------------------------------------------------------------------------\r\nTry it manually (copy-paste while the operator is running):\u001b[18;1H1. Create a DNSZone for example.org with two NS records:\u001b[20;1Hkubectl apply -f demo/dnszone.yaml\u001b[22;1H2. Update it (switch the NS records to ns3/ns4):\u001b[24;1Hkubectl apply -f demo/dnszone-updated.yaml\u001b[K\r\n\u001b[K\r\n3. Verify in Kubernetes and in PowerDNS:\u001b[K\r\n\u001b[K\r\nkubectl get dnszones\u001b[K\r\ndig +tcp @127.0.0.1 -p 1053 example.org NS\u001b[K\r\n\u001b[K\r\n4. Remove it when done:\u001b[K\r\n\u001b[K\r\nkubectl delete dnszone example-org\u001b[K\r\n------------------------------------------------------------------------\u001b[K\r\n\u001b[K\u001b[1;36r\u001b[35;1H\u001b[?2026l"]
